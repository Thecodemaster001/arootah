# Copy to .env.local. Never commit the real file — .env.local is gitignored.
# The key is read only in server-side code (src/lib/providers/*), never shipped to the browser.

# Which provider the triage route calls: "openai" | "anthropic" | "offline"
# "offline" needs no key: it answers from the hand-written results in
# data/offline-triage.json and makes no network calls.
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-xxxxxxxx
OPENAI_MODEL=gpt-5

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-opus-5

# Messages triaged in parallel. Keep low enough to stay under provider rate limits.
TRIAGE_CONCURRENCY=4

# --- Fault injection (demo only) -------------------------------------------
# Forces chosen message ids to fail, so error recovery can be shown against the
# real pipeline. Inert unless TRIAGE_FAIL_IDS is set; refuses to arm when
# NODE_ENV=production. Usually driven by `npm run demo:error` rather than set here.
#
#   TRIAGE_FAIL_IDS=inb-005,inb-002
#   TRIAGE_FAIL_MODE=api | rate-limit | malformed

