{
  "name": "inbound-triage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preflight": "node scripts/preflight.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:reset": "rm -f data/triage.json",
    "demo:error": "npm run demo:reset && TRIAGE_FAIL_IDS=inb-005 TRIAGE_FAIL_MODE=api next dev",
    "demo:ratelimit": "npm run demo:reset && TRIAGE_FAIL_IDS=inb-005 TRIAGE_FAIL_MODE=rate-limit next dev",
    "demo:malformed": "npm run demo:reset && TRIAGE_FAIL_IDS=inb-005 TRIAGE_FAIL_MODE=malformed next dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "next": "^15.5.4",
    "openai": "^7.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
